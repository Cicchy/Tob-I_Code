{
  "name": "tob-icode",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "format": "biome format --write src/",
    "electron:dev": "node scripts/dev-electron.cjs",
    "electron:build": "cross-env ELECTRON=true vite build && electron-builder"
  },
  "build": {
    "appId": "com.tob-icode.ide",
    "productName": "Tob-I IDE",
    "files": [
      "dist/**/*",
      "electron/**/*.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.13",
    "@radix-ui/react-label": "^2.1.5",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "blockly": "^12.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^3.8.1",
    "sonner": "^2.0.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "three": "^0.184.0",
    "vite": "^8.0.16"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./*": "./*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "tw-animate-css": "^1.4.0",
    "wait-on": "^9.0.10"
  }
}
