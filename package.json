{
  "name": "tob-icode",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/dev-electron.cjs",
    "electron:build": "cross-env ELECTRON=true vite build && electron-builder"
  },
  "build": {
    "appId": "com.tob-icode.ide",
    "productName": "Tob-I IDE",
    "files": [
      "dist/**/*",
      "electron/**/*.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@base-ui/react": "^1.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "blockly": "^12.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.1",
    "three": "^0.184.0",
    "vite": "^8.0.16"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./*": "./*"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "tw-animate-css": "^1.4.0",
    "wait-on": "^9.0.10"
  }
}
